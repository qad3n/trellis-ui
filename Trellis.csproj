<Project Sdk="Microsoft.NET.Sdk">

  <!-- standalone build that proves the library compiles without any host; hosts compile source/ directly -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>Trellis</AssemblyName>
    <RootNamespace>Trellis</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BaseOutputPath>build/bin</BaseOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- [Config] fields are written by the host config loader through reflection -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <UnityRefs Condition="'$(UnityRefs)' == ''">$(MSBuildThisFileDirectory)refs</UnityRefs>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="source/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(UnityRefs)/core/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(UnityRefs)/interop/Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(UnityRefs)/interop/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(UnityRefs)/interop/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(UnityRefs)/interop/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(UnityRefs)/interop/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(UnityRefs)/interop/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(UnityRefs)/interop/UnityEngine.UI.dll" Private="false" />
  </ItemGroup>

</Project>
